# Optional online-AI configuration. Keep disabled for the offline default.
AISD_ONLINE_AI_ENABLED=false
AISD_AI_MODE=offline
AISD_AI_PROVIDER=
AISD_AI_API_KEY=
AISD_AI_MODEL=
AISD_AI_TIMEOUT_SECONDS=30

# Optional portable storage overrides. Empty values use application defaults.
AISD_DATA_DIR=
AISD_LOGS_DIR=
AISD_REPORTS_DIR=
AISD_DATABASE_PATH=
AISD_DISK_FREE_THRESHOLD_PERCENT=10
